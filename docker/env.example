# Reference only. Generate .env.docker with python3 docker/setup.py (0600, random secrets).
# Never commit a filled environment file; never run `compose config` without --quiet in shared logs.
COMPOSE_PROJECT_NAME=msoj
MSOJ_SITE_URL=https://oj.example.com
DJANGO_ALLOWED_HOSTS=oj.example.com,localhost,127.0.0.1
MSOJ_HTTP_PORT=8080
MSOJ_BRIDGE_PORT=9999
APP_UID=1000
APP_GID=1000
MSOJ_DB_DIR=/srv/msoj/database
MSOJ_REDIS_DIR=/srv/msoj/redis
MSOJ_MEDIA_DIR=/srv/msoj/media
MSOJ_PROBLEM_DIR=/srv/msoj/problems
MSOJ_BACKUP_DIR=/srv/msoj/backups
# Release images: use matching commit SHA tags or sha256 digests. No production builds.
MSOJ_APP_IMAGE=ghcr.io/owner/msoj/app:COMMIT_SHA
MSOJ_PROXY_IMAGE=ghcr.io/owner/msoj/proxy:COMMIT_SHA
MSOJ_EVENTS_IMAGE=ghcr.io/owner/msoj/events:COMMIT_SHA
# Required secrets are generated by setup.py. Keep stable across web/worker/bridge/restarts.
DJANGO_SECRET_KEY=
MARIADB_DATABASE=msoj
MARIADB_USER=msoj
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
POLYGON_SYNC_AUTHOR=admin
POLYGON_API_KEY=
POLYGON_API_SECRET=
AI_9ROUTER_API_KEY=
# Set in Cloudflare dashboard: public hostname -> HTTP service http://proxy-tunnel:8081
CLOUDFLARE_TUNNEL_TOKEN=
MSOJ_CLOUDFLARE_UPLOAD_WARNING=true
MSOJ_REQUIRE_STAFF_2FA=true
# Email defaults to console (development). Real activation/reset email requires SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
